Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://c.disquscdn.com/next/recommendations/styles/recommendations.8a7bf6fda2d899f3cf4172f2429f6980.css

@charset "utf-8";

* { box-sizing: border-box; }

html.mobile.touch .scroll-btn { display: none; }

html.mobile.no-touch .scroll-btn { opacity: 1 !important; }

body { background: 0px 0px; color: rgb(42, 46, 46); font-family: "Helvetica Neue", arial, sans-serif; font-size: 15px; -webkit-font-smoothing: antialiased; }

body.dark { color: rgb(255, 255, 255); }

a { text-decoration: none; color: rgb(40, 140, 228); transition: color 0.1s linear; }

a:hover { color: rgb(25, 119, 202); }

a:active, a:hover { text-decoration: none; }

p { margin: 0px 0px 1.5em; }

h2, h3, strong, strong a { font-weight: 700; }

.sans-serif, .sans-serif input, .sans-serif select, .sans-serif textarea { font-family: "Helvetica Neue", arial, sans-serif; }

.serif, .serif input, .serif select, .serif textarea { font-family: Georgia, Times, serif; }

[dir="rtl"], [dir="rtl"] * { font-family: Tahoma, Geneva, "Helvetica Neue", Helvetica, Arial, Verdana, sans-serif; }

.recommendations-layout .post-list { backface-visibility: hidden; }

.recommendations-layout .post-list--in-embed { display: flex; }

.recommendations-layout .post-list--mobile { flex-direction: column; }

.recommendations-layout .alert--error { line-height: 1.4; border-radius: 4px; margin: 16px; padding: 16px; }

.recommendations-wrapper { display: flex; width: 100%; max-width: 100vw; }

.recommendations-wrapper .recommend-main { display: inline-block; position: relative; color: rgb(42, 46, 46); font-size: 14px; clear: both; width: 100%; }

.recommendations-wrapper .recommend-main:hover .scroll-btn { opacity: 1; }

.recommendations-wrapper .recommend-main.no-meta .recommend-content, .recommendations-wrapper .recommend-main.no-meta .recommend-top-comment-wrapper { max-height: calc(5.2em); padding-top: 2px; }

.recommendations-wrapper .recommend-main.no-meta.has-preview-title .recommend-content, .recommendations-wrapper .recommend-main.no-meta.has-preview-title .recommend-content .recommend-post-title { max-height: calc(5em); }

.recommendations-wrapper .recommend-main .scroll-btn { position: absolute; background: rgba(255, 255, 255, 0.7); color: rgba(0, 0, 0, 0.55); font-size: 36px; line-height: 0.9; height: 50px; top: calc(50% - 25px); border: 1px solid rgb(231, 233, 238); border-radius: 3px; padding: 8px; backdrop-filter: blur(2px); opacity: 0; transition: 250ms ease-in-out; cursor: pointer; outline: 0px; z-index: 99999; }

.recommendations-wrapper .recommend-main .scroll-btn:hover { background: rgba(255, 255, 255, 0.8); color: rgba(0, 0, 0, 0.65); backdrop-filter: blur(6px); opacity: 1; }

.recommendations-wrapper .recommend-main .scroll-btn.scroll-left { left: 0px; border-top-left-radius: 0px; border-bottom-left-radius: 0px; padding-left: 4px; }

.recommendations-wrapper .recommend-main .scroll-btn.scroll-right { right: 0px; border-top-right-radius: 0px; border-bottom-right-radius: 0px; padding-right: 4px; }

.recommend-col-header { margin-bottom: 12px; }

.recommend-col-header .recommendations-unit-title { font-size: 12.5px; font-weight: 700; text-transform: uppercase; color: rgba(101, 108, 122, 0.65); }

.recommend-col-header .recommendations-unit-title .recommendations-forum { color: rgb(61, 66, 74); }

@media screen and (max-width: 480px) {
  .recommend-col-header { margin-bottom: 0.4em; }
}

.recommend-wrapper { display: flex; flex-flow: row; align-items: center; justify-content: space-between; overflow: auto visible; white-space: nowrap; margin: 4px auto 10px; padding-top: 2px; scrollbar-width: none; }

.recommend-wrapper::-webkit-scrollbar { display: none; }

.recommend-post { position: relative; display: inline-block; background: rgb(255, 255, 255); width: 200px; height: 200px; border: 1px solid rgb(231, 233, 238); border-radius: 6px; justify-content: space-between; vertical-align: middle; transform: translate3d(0px, 0px, 0px); transition: 0.2s ease-in-out; margin: 0px 4px; cursor: pointer; transform-style: preserve-3d; backface-visibility: hidden; }

.recommend-post:first-child { margin-left: 0px; }

.recommend-post:last-child { margin-right: 0px; }

.recommend-post:focus, .recommend-post:hover { transform: translate3d(0px, -2px, 0px); }

.recommend-post:focus { outline-offset: -3px; }

.recommend-post:focus:not(:focus-visible) { border: 1px solid rgb(231, 233, 238); }

.recommend-post:focus-visible { border: 2px solid rgb(46, 159, 255); border-radius: calc(4px); }

